// Общий модуль. ЭлектронноеПодписаниеДоговоровСервер
// Сервер. Кнопка формы «Подписать со стороны университета и отправить студенту».
//
// ЗАГЛУШКИ: ПодписатьФайлУКЭПУниверситета, СформироватьФайлЗаявленияReqXml,
// СформироватьАрхивГосключ, СоздатьЗаявлениеЕПГУ, ЗагрузитьАрхивЕПГУ
// не обращаются к боевому ЕПГУ и не используют реальный сертификат.

#Область ПрограммныйИнтерфейс

// Точка входа команды формы элемента договора / доп. соглашения.
Функция ПодписатьСоСтороныУниверситетаИОтправитьНаЕПГУ(СсылкаНаОбъект) Экспорт

	Результат = Новый Структура("Успех, Сообщение, ИдентификаторЗаявленияЕПГУ", Ложь, "", "");

	Проверка = ПроверитьГотовностьКПодписанию(СсылкаНаОбъект);
	Если Не Проверка.Готово Тогда
		Результат.Сообщение = Проверка.Причина;
		Возврат Результат;
	КонецЕсли;

	ФайлПФ = ПечатьДоговоровОбразование.СформироватьPDFДляЭДО(СсылкаНаОбъект);

	ПодписьPDF = ПодписатьФайлУКЭПУниверситета(ФайлПФ.ДвоичныеДанные, ФайлПФ.ИмяФайла);
	ReqXml = СформироватьФайлЗаявленияReqXml(СсылкаНаОбъект, ФайлПФ);
	ПодписьReq = ПодписатьФайлУКЭПУниверситета(ReqXml, "req.xml");

	Архив = СформироватьАрхивГосключ(ФайлПФ, ПодписьPDF, ReqXml, ПодписьReq);
	Заявление = СоздатьЗаявлениеЕПГУ();
	ЗагрузитьАрхивЕПГУ(Заявление.ИдентификаторЗаявленияЕПГУ, Архив);

	ЗаписатьРезультатВОбъект(СсылкаНаОбъект, ФайлПФ, ПодписьPDF, Заявление.ИдентификаторЗаявленияЕПГУ);

	Результат.Успех = Истина;
	Результат.ИдентификаторЗаявленияЕПГУ = Заявление.ИдентификаторЗаявленияЕПГУ;
	Результат.Сообщение = НСтр("ru = 'Договор подписан со стороны университета и отправлен студенту (заглушка ЕПГУ).'");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьГотовностьКПодписанию(СсылкаНаОбъект)

	Результат = Новый Структура("Готово, Причина", Истина, "");
	Реквизиты = РеквизитыОбъектаДляПроверки(СсылкаНаОбъект);

	Если Реквизиты.Состояние <> Перечисления.СостоянияДоговоровОбучения.Утвержден Тогда
		Результат.Готово = Ложь;
		Результат.Причина = НСтр("ru = 'На подпись можно отправлять только утверждённый договор или доп. соглашение.'");
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(Реквизиты.СНИЛСПодписантаСтудента) И ПустаяСтрока(Реквизиты.ОИДЕСИАПодписанта) Тогда
		Результат.Готово = Ложь;
		Результат.Причина = НСтр("ru = 'Укажите СНИЛС или OID ЕСИА второй стороны — без этого ЕПГУ не примет заявление.'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция РеквизитыОбъектаДляПроверки(СсылкаНаОбъект)

	ИмяТаблицы = СсылкаНаОбъект.Метаданные().ПолноеИмя();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Объект.Состояние КАК Состояние,
		|	Объект.СНИЛСПодписантаСтудента КАК СНИЛСПодписантаСтудента,
		|	Объект.ОИДЕСИАПодписанта КАК ОИДЕСИАПодписанта
		|ИЗ
		|	" + ИмяТаблицы + " КАК Объект
		|ГДЕ
		|	Объект.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка;

КонецФункции

// ЗАГЛУШКА. Боевой контур: УКЭП юридического лица, отсоединённый PKCS#7 (.sig).
Функция ПодписатьФайлУКЭПУниверситета(ДвоичныеДанныеФайла, ИмяФайла)

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ЭлектронноеПодписаниеДоговоров.УКЭП'", "ru"),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон(НСтр("ru = 'Заглушка УКЭП университета для файла %1, размер %2 байт.'"),
			ИмяФайла,
			Формат(ДвоичныеДанныеФайла.Размер(), "ЧГ=0")));

	Возврат ПолучитьДвоичныеДанныеИзСтроки("STUB-UNIVERSITY-UKEP-SIGNATURE");

КонецФункции

// ЗАГЛУШКА. Боевой контур: req.xml по XSD Госключа, пространство имён УНЭП или УКЭП.
Функция СформироватьФайлЗаявленияReqXml(СсылкаНаОбъект, ФайлПФ)

	Текст = СтрШаблон(
		"<?xml version=""1.0"" encoding=""utf-8""?>
		|<ns:SignRequest xmlns:ns=""urn://mpkey.gosuslugi.ru/sign_document_ukep/1.0.0"">
		|  <ns:Snils>%1</ns:Snils>
		|  <ns:Document>
		|    <ns:DocumentId>%2</ns:DocumentId>
		|    <ns:MimeType>application/pdf</ns:MimeType>
		|    <ns:Description>Dogovor obuchenie</ns:Description>
		|    <ns:Backlink>https://lk.gosuslugi.ru/notifications</ns:Backlink>
		|    <ns:Attribute>
		|      <ns:AttributeName>orgName</ns:AttributeName>
		|      <ns:AttributeValue>University</ns:AttributeValue>
		|    </ns:Attribute>
		|  </ns:Document>
		|</ns:SignRequest>",
		"000-000-000 00",
		Строка(СсылкаНаОбъект.УникальныйИдентификатор()));

	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8);

КонецФункции

// ЗАГЛУШКА. Боевой контур: zip без вложенных папок — req.xml, PDF, *.sig.
Функция СформироватьАрхивГосключ(ФайлПФ, ПодписьPDF, ReqXml, ПодписьReq)

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ЭлектронноеПодписаниеДоговоров.АрхивГосключ'", "ru"),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru = 'Заглушка zip-архива для Госключа (req.xml + pdf + sig).'"));

	Возврат ПолучитьДвоичныеДанныеИзСтроки("STUB-GOSKEY-ZIP");

КонецФункции

// ЗАГЛУШКА. Боевой контур: POST api/gusmev/order, meta.serviceCode = 10000000374.
Функция СоздатьЗаявлениеЕПГУ()

	Результат = Новый Структура("ИдентификаторЗаявленияЕПГУ", "STUB-ORDER-" + Строка(Новый УникальныйИдентификатор));
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ЭлектронноеПодписаниеДоговоров.ЕПГУ'", "ru"),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон(НСтр("ru = 'Заглушка создания заявления ЕПГУ, orderId=%1'"), Результат.ИдентификаторЗаявленияЕПГУ));
	Возврат Результат;

КонецФункции

// ЗАГЛУШКА. Боевой контур: POST api/gusmev/push — загрузка архива заявления.
Процедура ЗагрузитьАрхивЕПГУ(ИдентификаторЗаявленияЕПГУ, Архив)

	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ЭлектронноеПодписаниеДоговоров.ЕПГУ'", "ru"),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		СтрШаблон(НСтр("ru = 'Заглушка загрузки архива в ЕПГУ, orderId=%1, размер=%2'"),
			ИдентификаторЗаявленияЕПГУ,
			Формат(Архив.Размер(), "ЧГ=0")));

КонецПроцедуры

Процедура ЗаписатьРезультатВОбъект(СсылкаНаОбъект, ФайлПФ, ПодписьPDF, ИдентификаторЗаявленияЕПГУ)

	Объект = СсылкаНаОбъект.ПолучитьОбъект();
	Объект.СостояниеЭП = Перечисления.СостоянияЭлектронногоПодписания.ОтправленСтуденту;
	Объект.ДатаПодписиУниверситета = ТекущаяДатаСеанса();
	Объект.ДатаОтправкиНаЕПГУ = ТекущаяДатаСеанса();
	Объект.ИдентификаторЗаявленияЕПГУ = ИдентификаторЗаявленияЕПГУ;
	Объект.Записать();

КонецПроцедуры

#КонецОбласти
