// Общий модуль. ПечатьДоговоровОбразование
// Сервер. Печатные формы договора и доп. соглашения — один контур для кнопки «Печать»
// и для PDF, который уходит на ЕПГУ.

#Область ПрограммныйИнтерфейс

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	Команда = КомандыПечати.Добавить();
	Команда.Идентификатор = "ДоговорОбразовательныеУслуги";
	Команда.Представление = НСтр("ru = 'Договор на оказание образовательных услуг'");
	Команда.МенеджерПечати = "ПечатьДоговоровОбразование";

	Команда = КомандыПечати.Добавить();
	Команда.Идентификатор = "ДополнительноеСоглашение";
	Команда.Представление = НСтр("ru = 'Дополнительное соглашение'");
	Команда.МенеджерПечати = "ПечатьДоговоровОбразование";

КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ДоговорОбразовательныеУслуги") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ДоговорОбразовательныеУслуги",
			НСтр("ru = 'Договор на оказание образовательных услуг'"),
			СформироватьПечатнуюФормуДоговора(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ДополнительноеСоглашение") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ДополнительноеСоглашение",
			НСтр("ru = 'Дополнительное соглашение'"),
			СформироватьПечатнуюФормуДопСоглашения(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

КонецПроцедуры

Функция СформироватьПечатнуюФормуДоговора(МассивОбъектов, ОбъектыПечати) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.ДоговорыНаОказаниеОбразовательныхУслуг.ПФ_MXL_Договор");

	Для Каждого Ссылка Из МассивОбъектов Цикл
		Данные = ПолучитьДанныеДляПечати(Ссылка);
		ЗаполнитьОбластиМакета(ТабличныйДокумент, Макет, Данные, "Договор");
	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

Функция СформироватьПечатнуюФормуДопСоглашения(МассивОбъектов, ОбъектыПечати) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = УправлениеПечатью.МакетПечатнойФормы(
		"Справочник.ДополнительныеСоглашенияКДоговорамОбучения.ПФ_MXL_ДопСоглашение");

	Для Каждого Ссылка Из МассивОбъектов Цикл
		Данные = ПолучитьДанныеДляПечати(Ссылка);
		ЗаполнитьОбластиМакета(ТабличныйДокумент, Макет, Данные, "ДопСоглашение");
	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

// Тот же макет, что и для бумаги: электронный экземпляр не должен расходиться с печатным.
Функция СформироватьPDFДляЭДО(СсылкаНаОбъект) Экспорт

	ОбъектыПечати = Новый СписокЗначений;
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ДоговорыНаОказаниеОбразовательныхУслуг") Тогда
		ТабличныйДокумент = СформироватьПечатнуюФормуДоговора(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаОбъект),
			ОбъектыПечати);
		ИмяФайла = "dogovor_obuchenie.pdf";
	Иначе
		ТабличныйДокумент = СформироватьПечатнуюФормуДопСоглашения(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаОбъект),
			ОбъектыПечати);
		ИмяФайла = "dop_soglashenie.pdf";
	КонецЕсли;

	Поток = Новый ПотокВПамяти;
	ТабличныйДокумент.Записать(Поток, ТипФайлаТабличногоДокумента.PDF);
	Возврат Новый Структура("ИмяФайла, ДвоичныеДанные", ИмяФайла, Поток.ЗакрытьИПолучитьДвоичныеДанные());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДанныеДляПечати(СсылкаНаОбъект)

	// Запрос по шапке, сторонам, учебному плану, стоимости и графику платежей.
	// Поля не вводятся заново: читаются из объекта и связанных справочников.
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", СсылкаНаОбъект);
	Результат.Вставить("Шапка", Новый Структура);
	Результат.Вставить("Стороны", Новый Структура);
	Результат.Вставить("ГрафикПлатежей", Новый ТаблицаЗначений);
	Возврат Результат;

КонецФункции

Процедура ЗаполнитьОбластиМакета(ТабличныйДокумент, Макет, Данные, ВидФормы)

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, Данные.Шапка);
	ТабличныйДокумент.Вывести(ОбластьШапка);

	ВывестиРеквизитыСторон(ТабличныйДокумент, Макет, Данные.Стороны);
	ВывестиГрафикПлатежей(ТабличныйДокумент, Макет, Данные.ГрафикПлатежей);

	ОбластьПодписи = Макет.ПолучитьОбласть("Подписи");
	ТабличныйДокумент.Вывести(ОбластьПодписи);

КонецПроцедуры

Процедура ВывестиРеквизитыСторон(ТабличныйДокумент, Макет, Стороны)

	Область = Макет.ПолучитьОбласть("Стороны");
	ЗаполнитьЗначенияСвойств(Область.Параметры, Стороны);
	ТабличныйДокумент.Вывести(Область);

КонецПроцедуры

Процедура ВывестиГрафикПлатежей(ТабличныйДокумент, Макет, ГрафикПлатежей)

	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаГрафика"));
	ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаГрафика");
	Для Каждого СтрокаГрафика Из ГрафикПлатежей Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаГрафика);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
