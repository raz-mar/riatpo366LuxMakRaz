@startuml logical-data
title Логическая схема данных. Справка об обучении

entity "Студент\n<<внешний, контингент>>" as Student {
  * идентификатор
  --
  числится
  ФИО
  номер студенческого
  факультет
  направление
  курс
  форма обучения
}

entity "Вид справки" as Kind {
  * название
  --
  в перечне автоматической выдачи
}

entity "Заявка" as Request {
  * номер
  --
  адресат
  статус
  причина отказа
}

entity "Файл справки" as File {
  * ссылка в кабинете
  --
  подписан организацией
}

entity "Запись журнала" as Journal {
  * номер записи
  --
  время выдачи
}

Student ||--o{ Request : подаёт
Kind ||--o{ Request : выбран в
Request ||--o| File : выпускает,\nесли выдана
Request ||--o| Journal : сопровождается,\nесли выдана
Journal ||--|| File : указывает на

note bottom of Student
  Кабинет контингент не хранит
  и не изменяет. Поля читаются,
  когда собирается файл.
end note

note bottom of Request
  Статус: принята, на рассмотрении,
  выдана, отказано.
  Причина есть только у отказа.
end note

@enduml
