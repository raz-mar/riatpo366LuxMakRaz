@startuml usecase
left to right direction

actor "Пациент" as Patient
actor "Врач" as Doctor

rectangle "Чат-бот записи к врачу через мессенджер МАХ" {
  usecase "UC-1. Авторизация по СНИЛС и телефону" as UC1
  usecase "UC-2. Переключение на профиль ребенка или родственника" as UC2
  usecase "UC-3. Запись на очный прием" as UC3
  usecase "UC-4. Запись на ТМК" as UC4
  usecase "UC-5. Просмотр записей" as UC5
  usecase "UC-6. Отмена очного приема или ТМК" as UC6
  usecase "UC-7. Скачивание медицинских документов (ЛН)" as UC7
  usecase "UC-8. Получение напоминаний о приеме" as UC8
  usecase "UC-9. Получение ТМК" as UC9
  usecase "UC-10. Закрытие ЛН" as UC10
  usecase "UC-11. Проведение ТМК" as UC11
}

' Связи для роли Пациент
Patient --> UC1
Patient --> UC2
Patient --> UC3
Patient --> UC4
Patient --> UC5
Patient --> UC6
Patient --> UC7
Patient --> UC8
Patient --> UC9

' Связи для роли Врач
Doctor --> UC10
Doctor --> UC11

@enduml